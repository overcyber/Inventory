###########################################
## CONFIGURAÇÕES DE SEGURANÇA E AMBIENTE ##
###########################################
SECRET_KEY=
SESSION_SALT=
LOG_DIR=logs
INVENTORY_INGEST_TOKEN=

###########################
## CONFIGURAÇÕES DE REDE ##
###########################
HOST=0.0.0.0
PORT=8000
DEBUG=False
HTTP_PORT=8080
HTTPS_PORT=8443

############################
## CONFIGURAÇÕES DE HTTPS ##
############################
USE_HTTPS=True
SSL_CERT_PATH=ssl/cert.pem
SSL_KEY_PATH=ssl/key.pem
SESSION_COOKIE_SECURE=

######################################
## CONTROLE DE ACESSO / PROXY       ##
######################################
ALLOWED_IP_RANGES=0.0.0.0/0
TRUST_PROXY=0

##################################
## FONTES / ASSET CORE          ##
##################################
SOURCE_SYNC_INTERVAL=3600
NETSCOPE_SOURCE_ENABLED=true
NETSCOPE_BACKGROUND_ENABLED=true
NETSCOPE_DISCOVERY_INTERVAL=900
NETSCOPE_MAX_HOSTS_PER_NETWORK=65536

#############################
## API DO WAZUH (MANAGER)  ##
#############################
WAZUH_ENABLED=false
WAZUH_PROTOCOL=https
WAZUH_HOST=
WAZUH_PORT=55000
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_TLS_VERIFY=true
WAZUH_CA_BUNDLE=
WAZUH_ACTIVE_GRACE_SECONDS=300
WAZUH_FETCH_WORKERS=5

################################
## WAZUH INDEXER (OPCIONAL)   ##
################################
WAZUH_INDEXER_ENABLED=false
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_TLS_VERIFY=true
WAZUH_INDEXER_CA_BUNDLE=
WAZUH_INDEXER_PAGE_SIZE=1000

################################
## OUTRAS FONTES              ##
################################
OSQUERY_ENABLED=false
OSQUERY_BINARY=osqueryi
SNMP_ENABLED=false
SNMP_TARGETS_JSON=[]
SSH_SOURCE_ENABLED=false
SSH_STRICT_HOST_KEY=true
SSH_TARGETS_JSON=[]
WINRM_SOURCE_ENABLED=false
WINRM_TARGETS_JSON=[]

###############################
## BANCO DE DADOS POSTGRESQL ##
###############################
DB_USER=inventorydb
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db

###################
## CACHE REDIS   ##
###################
REDIS_URL=redis://localhost:6379/0

########################################
## ADMIN INICIAL (só com banco vazio) ##
########################################
ADMIN_PASSWORD=
ADMIN_MUST_CHANGE_PASSWORD=true

#################################################
## GATEWAY DE API — rotas de API não expostas ##
#################################################
API_LOCK=1

############################
## EVENTOS / INTEGRAÇÕES  ##
############################
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_ASSET_TOPIC=asset.snapshot.v1
ASSET_WEBHOOK_URLS=
ASSET_WEBHOOK_TOKEN=

############################
## ASSISTENTE IA — GROQ   ##
############################
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
