https://{$INVENTORY_TLS_HOST:localhost}:9443 {
    tls {
        issuer internal
        client_auth {
            mode require_and_verify
            trust_pool file {
                pem_file /etc/caddy/mtls/ca.pem
            }
        }
    }

    @ingest path /api/v1/assets/observations*
    handle @ingest {
        reverse_proxy inventory-web:8000
    }

    respond "Not Found" 404
}
